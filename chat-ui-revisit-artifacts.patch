+++ b/artifacts/chat-ui-revist/index.html
@@ -0,0 +1,11 @@
+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chat UI Revisit</title>
+<style>:root{--bg:#fff;--fg:#2d2c2b;--muted:#63605d;--line:#e2ded9;--card:#f6f1ef}
+@media (prefers-color-scheme:dark){:root{--bg:#141312;--fg:#e6e1e0;--muted:#cac6c2;--line:#494644;--card:#211f1e}}
+body{margin:0;padding:24px 16px;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,sans-serif}
+h1{font-size:22px;margin:0 0 4px} p{color:var(--muted);margin:0 0 12px}
+main{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,420px),1fr));gap:20px}
+section{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px}
+h2{font-size:15px;margin:0} .pair{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px}
+figure{margin:0} img{width:100%;height:auto;border:1px solid var(--line);border-radius:10px;background:#fff}
