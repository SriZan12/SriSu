+            .size(size)
+            .clip(CircleShape)
+            .background(MaterialTheme.colorScheme.secondaryContainer),
+        contentAlignment = Alignment.Center,
+    ) {
+        // Initials are decorative inside a fixed circle, so they follow the avatar size, not font scale.
