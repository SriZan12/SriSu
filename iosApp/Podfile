platform :ios, '15.0'
use_frameworks!

ENV['LIBSIGNAL_FFI_PREBUILD_CHECKSUM'] = '556a82414b545490085a0e21d94990788bdcbee4d769043f7889397872443faf'

target 'iosApp' do
  pod 'LibSignalClient', :git => 'https://github.com/signalapp/libsignal.git', :tag => 'v0.105.0'
end

post_install do |installer|
  # Keep CocoaPods products in Xcode's active build directory. The generated
  # default `${SRCROOT}/../build` path is separate from DerivedData, so the app
  # cannot find LibSignalClient when built from the project scheme.
  installer.pods_project.build_configurations.each do |config|
    config.build_settings.delete('SYMROOT')
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
    end
  end
  # CocoaPods does not preserve Xcode's newer synchronized-folder xcconfig anchor.
  # Explicit references keep SriSu's product name, bundle ID and Java path intact.
  installer.aggregate_targets.map(&:user_project).uniq.each do |project|
    project.targets.select { |target| target.name == 'iosApp' }.each do |target|
      target.build_configurations.each do |config|
        path = "Configuration/#{config.name}.xcconfig"
        reference = project.files.find { |file| file.path == path } || project.main_group.new_file(path)
        config.base_configuration_reference = reference
        config.base_configuration_reference_anchor = nil if config.respond_to?(:base_configuration_reference_anchor=)
        config.base_configuration_reference_relative_path = nil if config.respond_to?(:base_configuration_reference_relative_path=)
        config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end

      # Make project-scheme builds compile CocoaPods before the app's Swift files.
      pods_project_path = File.join(project.project_dir, 'Pods', 'Pods.xcodeproj')
      unless project.reference_for_path(pods_project_path)
        project.main_group.new_reference(pods_project_path, :group)
      end
      pods_target = installer.pods_project.targets.find { |candidate| candidate.name == 'Pods-iosApp' }
      target.add_dependency(pods_target) if pods_target
    end
    project.save
  end
end
